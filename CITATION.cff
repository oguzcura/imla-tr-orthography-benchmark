    given-names: Oğuz Emre
    email: oguzemrecura@gmail.com
    website: https://github.com/oguzcura
keywords:
  - Turkish NLP
  - orthography
  - LLM evaluation
  - benchmark
  - zero-cost evaluation
date-released: "2026-09-04"
